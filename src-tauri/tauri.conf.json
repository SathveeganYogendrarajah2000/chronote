{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "chronote",
  "version": "0.1.0",
  "identifier": "com.chronote.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Chronote — Your work. Remembered.",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Chronote Authors",
    "copyright": "Copyright © 2026 Chronote Authors",
    "category": "Productivity",
    "shortDescription": "Lightweight local-first desktop engineering work notebook",
    "longDescription": "The fastest lightweight searchable engineering work journal and stand-up notebook for developers.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "en-US"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": [
          "en-US"
        ],
        "upgradeCode": "9b7d3444-4822-44df-9d51-c30c33a948c2"
      }
    }
  }
}
